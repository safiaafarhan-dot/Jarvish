/* ══════════════════════════════════════════════════════════════════
   JARVISH — HUD client

   Four things run at once here: the reactive core, the telemetry
   stream, the agent event stream, and the voice pipeline. They all
   talk through `setState`, which is the single place the interface's
   mood is decided.
   ══════════════════════════════════════════════════════════════════ */

const $ = (id) => document.getElementById(id);

const el = {
  body: document.body, hud: $("hud"),
  field: $("field"), core: $("core"),
  coreState: $("core-state"), coreDetail: $("core-detail"),
  transcript: $("transcript"), pipeline: $("pipeline"), track: $("pipeline-track"),
  input: $("input"), send: $("send-btn"), mic: $("mic-btn"), wake: $("wake-btn"),
  csText: $("cs-text"), hint: $("console-hint"),
  stop: $("stop-btn"), reset: $("reset-btn"), mute: $("mute-btn"), muteIcon: $("mute-icon"),
  brandSub: $("brand-sub"),
  linkOllama: $("link-ollama"), linkModel: $("link-model"),
  linkNet: $("link-net"), linkNetState: $("link-net-state"),
  linkVoice: $("link-voice"), linkVoiceState: $("link-voice-state"),
  linkTools: $("link-tools"), toolCount: $("link-tool-count"),
  gauges: $("gauges"), netgraph: $("netgraph"), insights: $("insights"),
  rMem: $("r-mem"), rDisk: $("r-disk"), rProc: $("r-proc"), rBatt: $("r-batt"),
  rUp: $("r-up"), rDown: $("r-down"), rUptime: $("r-uptime"),
  procList: $("proc-list"),
  stream: $("stream"), activityCount: $("activity-count"),
  memory: $("memory"), rules: $("rules"), refreshMemory: $("refresh-memory"),
  linkVision: $("link-vision"), linkVisionState: $("link-vision-state"),
  linkBrowser: $("link-browser"), linkBrowserState: $("link-browser-state"),
  linkKb: $("link-kb"), linkKbState: $("link-kb-state"),
  linkWatch: $("link-watch"), linkWatchState: $("link-watch-state"),
  linkMission: $("link-mission"), linkMissionState: $("link-mission-state"),
  missionPanel: $("panel-mission"), missionGoal: $("mission-goal"),
  missionState: $("mission-state"), missionFill: $("mission-fill"),
  missionProgress: $("mission-progress"), missionTasks: $("mission-tasks"),
  missionCurrent: $("mission-current"), missionActions: $("mission-actions"),
  linkPlugins: $("link-plugins"), linkPluginsState: $("link-plugins-state"),
  linkAutonomy: $("link-autonomy"), linkAutonomyState: $("link-autonomy-state"),
  autonomyLevels: $("autonomy-levels"), autonomyName: $("autonomy-name"),
  autonomyNote: $("autonomy-note"),
  capsPanel: $("panel-caps"), caps: $("caps"), capsCount: $("caps-count"),
  capsNote: $("caps-note"), reloadPlugins: $("reload-plugins"),
  devPanel: $("panel-dev"), devRows: $("dev-rows"), devStage: $("dev-stage"),
  devEvidence: $("dev-evidence"),
  alertsPanel: $("panel-alerts"), alerts: $("alerts"), alertCount: $("alert-count"),
  quietBtn: $("quiet-btn"), dismissAlerts: $("dismiss-alerts"),
  tasksPanel: $("panel-tasks"), tasks: $("tasks"), taskCount: $("task-count"),
  kbPanel: $("panel-knowledge"), kbSources: $("kb-sources"),
  kbMethod: $("kb-method"), kbNote: $("kb-note"),
  visionPanel: $("panel-vision"), visionShot: $("vision-shot"),
  visionBoxes: $("vision-boxes"), visionMeta: $("vision-meta"),
  visionNote: $("vision-note"), visionMode: $("vision-mode"),
  gate: $("gate"), gateCard: document.querySelector(".gate-card"),
  gateBadge: $("gate-badge"), gateTitle: $("gate-title"), gateReason: $("gate-reason"),
  gatePreview: $("gate-preview"), gateMeta: $("gate-meta"),
  gateCeiling: $("gate-ceiling"),
  gateAllow: $("gate-allow"), gateDeny: $("gate-deny"),
  toasts: $("toasts"),
};

const state = {
  history: [],
  session: null,
  busy: false,
  agent: "idle",
  wakeWord: "jarvis",
  muted: localStorage.getItem("jarvish.muted") === "1",
  controller: null,
  pendingGate: null,
  events: 0,
};

/* ══════════════════════ small helpers ══════════════════════ */

const esc = (s) => String(s)
  .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const clamp = (n, lo, hi) => Math.max(lo, Math.min(hi, n));

function clock(ts) {
  const d = ts ? new Date(ts * 1000) : new Date();
  return d.toTimeString().slice(0, 8);
}

function bytes(perSecond) {
  if (perSecond < 1024) return Math.round(perSecond) + " B/s";
  if (perSecond < 1024 * 1024) return (perSecond / 1024).toFixed(0) + " KB/s";
  return (perSecond / 1048576).toFixed(1) + " MB/s";
}

function duration(seconds) {
  const h = Math.floor(seconds / 3600), m = Math.floor((seconds % 3600) / 60);
  return h ? h + "h " + m + "m" : m + "m";
}

function toast(text, kind) {
  const node = document.createElement("div");
  node.className = "toast" + (kind === "err" ? " err" : "");
  node.textContent = text;
  el.toasts.appendChild(node);
  setTimeout(() => {
    node.style.transition = "opacity .3s, transform .3s";
    node.style.opacity = "0";
    node.style.transform = "translateY(8px)";
    setTimeout(() => node.remove(), 320);
  }, 3400);
}

function accent() {
  return getComputedStyle(document.documentElement)
    .getPropertyValue("--accent-rgb").trim() || "34, 211, 238";
}

/* ══════════════════════ agent state ══════════════════════ */

const STATE_CAPTIONS = {
  idle:       ["STANDBY",    "say “jarvis”, or type below"],
  listening:  ["LISTENING",  "go ahead"],
  analyzing:  ["ANALYSING",  "reading the request"],
  planning:   ["PLANNING",   "choosing tools"],
  executing:  ["EXECUTING",  "working"],
  recovering: ["RECOVERING", "a step failed — trying another route"],
  verifying:  ["VERIFYING",  "checking the results"],
  speaking:   ["SPEAKING",   ""],
  complete:   ["COMPLETE",   ""],
  stopped:    ["HALTED",     "everything stopped"],
  error:      ["FAULT",      "see the message above"],
  awaiting:   ["AWAITING",   "confirmation required"],
};

function setState(name, detail) {
  state.agent = name;
  // Reached through the window rather than the binding: `setState` runs during
  // boot, and `typeof` on a const still in its temporal dead zone throws.
  if (window.__presence) window.__presence.sync();
  el.body.dataset.state = name;
  const [label, fallback] = STATE_CAPTIONS[name] || [name.toUpperCase(), ""];
  el.coreState.textContent = label;
  el.coreDetail.textContent = detail || fallback;
  el.csText.textContent = detail || label.toLowerCase();
  el.body.classList.toggle(
    "working",
    ["analyzing", "planning", "executing", "recovering", "verifying"].includes(name)
  );
}

/* ══════════════════════ the pointer field ══════════════════════

   One shared reading of where the cursor is, in client coordinates, plus how
   fast it is moving. Both canvases below treat it as a body moving through the
   environment rather than as a pointer: it displaces what is near it, and the
   field springs back on its own. Deliberately weak — a trail would read as a
   toy, a slight bend in the field reads as touching something. */

const pointer = { x: -9e9, y: -9e9, on: 0, speed: 0, lx: 0, ly: 0, ripple: 0 };

addEventListener("pointermove", (event) => {
  const dx = event.clientX - pointer.lx;
  const dy = event.clientY - pointer.ly;
  pointer.speed = Math.min(1, Math.hypot(dx, dy) / 34);
  pointer.lx = event.clientX; pointer.ly = event.clientY;
  pointer.x = event.clientX;  pointer.y = event.clientY;
  pointer.on = 1;
}, { passive: true });

addEventListener("pointerdown", () => { pointer.ripple = 1; }, { passive: true });
document.addEventListener("pointerleave", () => { pointer.on = 0; });

const CALM = window.matchMedia
  ? window.matchMedia("(prefers-reduced-motion: reduce)").matches : false;

/* ══════════════════════ background field ══════════════════════

   Atmosphere, not decoration. Three depth tiers of motes drifting at their own
   rates, over a lattice that is almost — but never quite — invisible. There is
   no third dimension here, only the cues for one: size, opacity, speed and
   parallax do all the work, which is what keeps this affordable on a machine
   already spending itself on a local model. */

(function field() {
  const canvas = el.field;
  const ctx = canvas.getContext("2d");
  let motes = [];
  let traces = [];
  let dpr = 1;
  let t = 0;

  // Back to front. Far motes barely move and barely register; near ones carry
  // the parallax. Nothing here is bright enough to be looked at directly.
  const DEPTHS = [
    { z: 0.26, size: 0.9, alpha: 0.055, drift: 0.030, share: 0.44 },
    { z: 0.58, size: 1.4, alpha: 0.105, drift: 0.075, share: 0.36 },
    { z: 1.00, size: 2.1, alpha: 0.165, drift: 0.140, share: 0.20 },
  ];

  function spawnTrace() {
    const vertical = Math.random() < 0.45;
    return {
      vertical,
      at: vertical ? Math.random() * innerWidth : Math.random() * innerHeight,
      p: -0.25 - Math.random() * 0.8,
      speed: 0.0011 + Math.random() * 0.0016,
      len: 0.10 + Math.random() * 0.16,
      dir: Math.random() < 0.5 ? 1 : -1,
    };
  }

  function size() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = innerWidth * dpr;
    canvas.height = innerHeight * dpr;
    canvas.style.width = innerWidth + "px";
    canvas.style.height = innerHeight + "px";
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const budget = clamp(Math.round((innerWidth * innerHeight) / 12500), 40, 190);
    motes = [];
    for (const d of DEPTHS) {
      for (let k = 0; k < Math.round(budget * d.share); k++) {
        const angle = Math.random() * Math.PI * 2;
        motes.push({
          x: Math.random() * innerWidth,
          y: Math.random() * innerHeight,
          vx: Math.cos(angle) * d.drift,
          vy: Math.sin(angle) * d.drift * 0.6,
          ox: 0, oy: 0,                 // cursor displacement; springs back
          phase: Math.random() * Math.PI * 2,
          d,
        });
      }
    }

    // A sparse set of data traces: short segments travelling a fixed line and
    // fading. Three alive at once is the whole effect.
    traces = Array.from({ length: 3 }, spawnTrace);
  }

  function frame() {
    t += 1;
    ctx.clearRect(0, 0, innerWidth, innerHeight);
    const rgb = accent();
    const motion = CALM ? 0.25 : 1;

    // ── the lattice: two very faint families of lines, sliding slowly, so the
    // background has a structure to be the background *of*.
    const cell = 118;
    const slide = (t * 0.06 * motion) % cell;
    ctx.lineWidth = 1;
    ctx.strokeStyle = "rgba(" + rgb + ",0.034)";
    ctx.beginPath();
    for (let x = -cell + slide; x < innerWidth + cell; x += cell) {
      ctx.moveTo(x, 0); ctx.lineTo(x, innerHeight);
    }
    ctx.stroke();
    ctx.strokeStyle = "rgba(" + rgb + ",0.020)";
    ctx.beginPath();
    for (let y = -cell + slide * 0.6; y < innerHeight + cell; y += cell) {
      ctx.moveTo(0, y); ctx.lineTo(innerWidth, y);
    }
    ctx.stroke();

    // ── data traces travelling the lattice
    for (let i = 0; i < traces.length; i++) {
      const tr = traces[i];
      tr.p += tr.speed * motion;
      if (tr.p > 1.3) { traces[i] = spawnTrace(); continue; }
      const span = tr.vertical ? innerHeight : innerWidth;
      const head = tr.dir > 0 ? tr.p * span : span - tr.p * span;
      const tail = head - tr.dir * tr.len * span;
      const grad = tr.vertical
        ? ctx.createLinearGradient(0, tail, 0, head)
        : ctx.createLinearGradient(tail, 0, head, 0);
      grad.addColorStop(0, "rgba(" + rgb + ",0)");
      grad.addColorStop(1, "rgba(" + rgb + ",0.13)");
      ctx.strokeStyle = grad;
      ctx.beginPath();
      if (tr.vertical) { ctx.moveTo(tr.at, tail); ctx.lineTo(tr.at, head); }
      else             { ctx.moveTo(tail, tr.at); ctx.lineTo(head, tr.at); }
      ctx.stroke();
    }

    // ── the motes, with the cursor bending the field around itself
    const reach = 132;
    for (const m of motes) {
      m.x += m.vx * motion;
      m.y += m.vy * motion;
      if (m.x < -10) m.x = innerWidth + 10;
      if (m.x > innerWidth + 10) m.x = -10;
      if (m.y < -10) m.y = innerHeight + 10;
      if (m.y > innerHeight + 10) m.y = -10;

      if (pointer.on) {
        const dx = m.x + m.ox - pointer.x;
        const dy = m.y + m.oy - pointer.y;
        const dist = Math.hypot(dx, dy);
        if (dist < reach && dist > 0.5) {
          const force = Math.pow(1 - dist / reach, 2) * 1.6 * m.d.z;
          m.ox += (dx / dist) * force;
          m.oy += (dy / dist) * force;
        }
      }
      m.ox *= 0.93;                     // spring back, always
      m.oy *= 0.93;

      const near = Math.hypot(m.x + m.ox - pointer.x, m.y + m.oy - pointer.y);
      const lit = pointer.on ? Math.pow(Math.max(0, 1 - near / reach), 2) : 0;
      const twinkle = 0.75 + Math.sin(t * 0.011 + m.phase) * 0.25;
      const a = (m.d.alpha * twinkle + lit * 0.30).toFixed(3);
      ctx.fillStyle = "rgba(" + rgb + "," + a + ")";
      ctx.beginPath();
      ctx.arc(m.x + m.ox, m.y + m.oy, m.d.size * 0.5 * (1 + lit * 0.7), 0, Math.PI * 2);
      ctx.fill();
    }

    // ── a light ripple where the field was touched
    if (pointer.ripple > 0.002) {
      ctx.beginPath();
      ctx.arc(pointer.x, pointer.y, (1 - pointer.ripple) * 190, 0, Math.PI * 2);
      ctx.strokeStyle = "rgba(" + rgb + "," + (pointer.ripple * 0.16).toFixed(3) + ")";
      ctx.lineWidth = 1;
      ctx.stroke();
      pointer.ripple *= 0.955;
    } else {
      pointer.ripple = 0;
    }

    pointer.speed *= 0.9;
    requestAnimationFrame(frame);
  }

  addEventListener("resize", size);
  size();
  frame();
})();

/* ══════════════════════ the environment ══════════════════════

   What surrounds the figure. This canvas sits *behind* the humanoid and owns
   no state of its own — it reads the agent state that already exists and the
   live microphone level, exactly as the renderer beside it does.

   The composition is a hierarchy and it is enforced here rather than hoped
   for: nothing drawn in this file is allowed to be brighter or busier than the
   bust it stands behind. Depth comes from scale, opacity, rate and parallax —
   four orbital structures at tilts and periods that never line up, a floor
   that recedes, and motes whose speed is explained by their apparent size.
   Adding objects would have been easier and would have looked worse. */

const coreView = (function () {
  const canvas = el.core;
  const ctx = canvas.getContext("2d");
  let w = 0, h = 0, dpr = 1;
  let t = 0;
  let amp = 0, ampTarget = 0;
  let glitch = 0;
  let gather = 0, gatherTarget = 0;     // listening draws the field inward
  let ripples = [];
  let nextIdleRipple = 420;
  let lastPulseSeq = -1;

  // Rates are mutually irrational enough that the ring set never returns to
  // the same arrangement twice in a session.
  const orbits = [
    { r: 0.98, squash: 0.40, tilt:  0.20, rate: -0.0068, ticks: 24, wide: 1.0, alpha: 0.28 },
    { r: 1.26, squash: 0.28, tilt: -0.09, rate:  0.0045, ticks: 48, wide: 0.9, alpha: 0.19 },
    { r: 1.58, squash: 0.19, tilt:  0.15, rate: -0.0029, ticks: 32, wide: 0.7, alpha: 0.12 },
    { r: 1.98, squash: 0.12, tilt: -0.04, rate:  0.0017, ticks: 64, wide: 0.6, alpha: 0.08 },
  ];

  // Data motes sharing the stage with the figure. Depth is `z`: it scales
  // size, dims alpha and slows the angular rate together, which is what makes
  // a flat canvas read as a volume.
  const motes = Array.from({ length: 86 }, () => ({
    a: Math.random() * Math.PI * 2,
    r: 0.58 + Math.random() * 1.35,
    y: (Math.random() - 0.5) * 1.05,
    squash: 0.16 + Math.random() * 0.26,
    speed: (0.0009 + Math.random() * 0.0022) * (Math.random() < 0.5 ? -1 : 1),
    bob: Math.random() * Math.PI * 2,
    z: 0.3 + Math.random() * 0.7,
    ox: 0, oy: 0,
  }));

  function size() {
    const box = canvas.getBoundingClientRect();
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = box.width; h = box.height;
    canvas.width = w * dpr; canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  /* One orbital ring: a tilted ellipse with a sparse tick ruler and a single
     travelling segment of light. The ticks are what make it read as
     instrumentation rather than as a hoop. */
  function orbit(cx, cy, base, o, spin, rgb, energy, index) {
    const wobble = Math.sin(t * 0.0033 + index * 1.7) * 0.055
                 + Math.sin(t * 0.0012 + index * 4.1) * 0.035;
    const rx = base * o.r * (1 + amp * 0.05 + Math.sin(t * 0.0017 + index) * 0.012);
    const ry = rx * (o.squash + wobble * 0.35);

    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(o.tilt + wobble);

    ctx.beginPath();
    ctx.ellipse(0, 0, rx, ry, 0, 0, Math.PI * 2);
    ctx.strokeStyle = "rgba(" + rgb + "," + (o.alpha * (0.6 + energy * 0.5)).toFixed(3) + ")";
    ctx.lineWidth = o.wide;
    ctx.stroke();

    ctx.lineWidth = 1;
    ctx.strokeStyle = "rgba(" + rgb + "," + (o.alpha * 0.55).toFixed(3) + ")";
    ctx.beginPath();
    for (let k = 0; k < o.ticks; k++) {
      const a = spin + (k / o.ticks) * Math.PI * 2;
      const len = k % 4 === 0 ? 5.5 : 2.5;
      const c = Math.cos(a), s = Math.sin(a);
      ctx.moveTo(c * rx, s * ry);
      ctx.lineTo(c * (rx + len), s * (ry + len * o.squash));
    }
    ctx.stroke();

    const head = spin * 3.1;
    ctx.beginPath();
    ctx.ellipse(0, 0, rx, ry, 0, head - (0.5 + energy * 0.5), head);
    ctx.strokeStyle = "rgba(" + rgb + "," + (0.10 + energy * 0.30).toFixed(3) + ")";
    ctx.lineWidth = o.wide * 1.7;
    ctx.lineCap = "round";
    ctx.stroke();

    ctx.restore();
  }

  /* The floor the figure is projected onto: a few lines under the cut, spaced
     so they crowd toward a horizon. Perspective, from nothing but spacing. */
  function floorGrid(cx, y0, base, rgb, energy) {
    const rise = base * 0.30;                    // how far back the floor goes
    ctx.lineWidth = 1;
    // Drawn one line at a time so the far ones can fade. Uniform brightness
    // reads as a flat pattern; falloff is what reads as distance.
    for (let k = 0; k <= 4; k++) {
      const depth = Math.pow(k / 4, 1.6);        // crowding toward the horizon
      const yy = y0 + rise * 0.35 - depth * rise;
      const half = base * (1.20 - depth * 0.72);
      const a = (0.20 + energy * 0.10) * (1 - depth * 0.80);
      const line = ctx.createLinearGradient(cx - half, 0, cx + half, 0);
      line.addColorStop(0, "rgba(" + rgb + ",0)");
      line.addColorStop(0.5, "rgba(" + rgb + "," + a.toFixed(3) + ")");
      line.addColorStop(1, "rgba(" + rgb + ",0)");
      ctx.strokeStyle = line;
      ctx.beginPath();
      ctx.moveTo(cx - half, yy);
      ctx.lineTo(cx + half, yy);
      ctx.stroke();
    }
  }

  function frame() {
    if (!w || !h) size();
    t += 1;

    // Energy eases toward whatever the current state asks for. This mapping is
    // a mirror: it reads the agent state, it never decides it.
    const s = state.agent;
    if (s === "listening") ampTarget = Math.max(0.16, mic.level);
    else if (s === "executing" || s === "planning") ampTarget = 0.34 + Math.sin(t / 9) * 0.1;
    else if (s === "analyzing" || s === "verifying") ampTarget = 0.24 + Math.sin(t / 16) * 0.07;
    else if (s === "speaking") ampTarget = 0.32 + Math.abs(Math.sin(t / 5.5)) * 0.34;
    else if (s === "recovering" || s === "error") ampTarget = 0.4 + Math.sin(t / 4) * 0.2;
    else ampTarget = 0.08 + Math.sin(t / 44) * 0.05;   // idle breathing

    amp += (ampTarget - amp) * 0.11;
    gatherTarget = s === "listening" ? 1 : (s === "awaiting" ? 0.8 : 0);
    gather += (gatherTarget - gather) * 0.05;
    if (s === "error" || s === "stopped") glitch = Math.max(glitch, 0.6);
    glitch *= 0.94;

    const motion = CALM ? 0.3 : 1;
    const shake = glitch > 0.02 ? (Math.random() - 0.5) * glitch * 5 : 0;
    const cx = w / 2;
    const cy = h * 0.545 + shake;    // the chest: where the core sits
    const cyLight = h * 0.34 + shake * 0.5;   // behind the head and shoulders
    const cyFloor = h * 0.79;        // just under the cut, below the plinth
    const base = Math.min(w, h * 1.5) * 0.30;
    const rgb = accent();

    ctx.clearRect(0, 0, w, h);

    const busy = ["analyzing", "planning", "executing", "verifying", "recovering"];
    const speed = s === "recovering" ? 3.2 : busy.indexOf(s) >= 0 ? 2.4 : 1;
    const energy = clamp(amp * 1.4, 0, 1);

    // ── volumetric illumination behind the figure, breathing on its own clock
    const bloom = base * (2.7 + Math.sin(t / 130) * 0.16 + amp * 0.5);
    const light = ctx.createRadialGradient(cx, cyLight, 0, cx, cyLight, bloom);
    light.addColorStop(0, "rgba(" + rgb + "," + (0.11 + amp * 0.10).toFixed(3) + ")");
    light.addColorStop(0.42, "rgba(" + rgb + ",0.035)");
    light.addColorStop(1, "rgba(" + rgb + ",0)");
    ctx.fillStyle = light;
    ctx.fillRect(0, 0, w, h);

    floorGrid(cx, cyFloor, base, rgb, energy);

    for (let i = 0; i < orbits.length; i++) {
      const o = orbits[i];
      // Variable angular velocity: the integral of a rate that wanders, so
      // the ring speeds up and slows without ever jumping.
      const wander = Math.sin(t * (0.0021 + i * 0.0007) + i * 2.3) * 0.42;
      const spin = t * o.rate * speed * motion * (1 + wander) + i * 1.9;
      orbit(cx, cy, base, o, spin, rgb, energy, i);
    }

    // ── the motes. Cursor influence is applied in screen space and springs
    // back; listening pulls the whole field in toward the figure.
    const box = canvas.getBoundingClientRect();
    const px = pointer.on ? pointer.x - box.left : -9e9;
    const py = pointer.on ? pointer.y - box.top : -9e9;
    const reach = base * 0.75;

    for (const m of motes) {
      m.a += m.speed * speed * m.z * motion * (1 + amp * 0.5);
      m.bob += 0.004 * motion;
      const pull = 1 - gather * 0.32;
      const rr = base * m.r * pull * (1 + amp * 0.06);
      let x = cx + Math.cos(m.a) * rr;
      let y = cy + m.y * base * pull + Math.sin(m.a) * rr * m.squash
                 + Math.sin(m.bob) * base * 0.02;

      if (glitch > 0.02) {
        x += (Math.random() - 0.5) * glitch * base * 0.22;
        y += (Math.random() - 0.5) * glitch * base * 0.22;
      }

      if (pointer.on) {
        const dx = x + m.ox - px, dy = y + m.oy - py;
        const dist = Math.hypot(dx, dy);
        if (dist < reach && dist > 0.5) {
          const force = Math.pow(1 - dist / reach, 2) * m.z * 2.4;
          m.ox += (dx / dist) * force;
          m.oy += (dy / dist) * force;
        }
      }
      m.ox *= 0.90;
      m.oy *= 0.90;

      const a = (0.06 + m.z * 0.20 + amp * 0.16 + gather * 0.10).toFixed(3);
      ctx.fillStyle = "rgba(" + rgb + "," + a + ")";
      ctx.beginPath();
      ctx.arc(x + m.ox, y + m.oy,
              (0.5 + m.z * 1.5) * (1 + amp * 0.4), 0, Math.PI * 2);
      ctx.fill();
    }

    // ── scan sweep: one clean band climbing the stage, and only while there
    // is actually something being scanned.
    if (busy.indexOf(s) >= 0) {
      const p = (t * 0.0042 * speed) % 1;
      const yy = cy + base * 0.7 - p * base * 1.7;
      const half = base * (1.85 - p * 0.5);
      const band = ctx.createLinearGradient(cx - half, 0, cx + half, 0);
      band.addColorStop(0, "rgba(" + rgb + ",0)");
      band.addColorStop(0.5, "rgba(" + rgb + "," + (0.16 * (1 - p)).toFixed(3) + ")");
      band.addColorStop(1, "rgba(" + rgb + ",0)");
      ctx.strokeStyle = band;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(cx - half, yy);
      ctx.lineTo(cx + half, yy);
      ctx.stroke();
    }

    // ── energy pulses travelling out through the environment. One source is
    // the environment's own slow clock; the other is the figure — when the
    // humanoid fires an event, the field around it answers.
    const engine = window.jarvishHumanoid;
    if (engine && engine.pulse && engine.pulse.seq !== lastPulseSeq) {
      lastPulseSeq = engine.pulse.seq;
      if (engine.pulse.at >= 0 && ripples.length < 5) {
        ripples.push({ p: 0, strength: clamp(engine.pulse.strength, 0.3, 1) });
      }
    }
    if (--nextIdleRipple <= 0) {
      ripples.push({ p: 0, strength: 0.5 });
      nextIdleRipple = 520 + Math.random() * 700;
    }
    for (let i = ripples.length - 1; i >= 0; i--) {
      const rp = ripples[i];
      rp.p += 0.0075 * motion;
      if (rp.p >= 1) { ripples.splice(i, 1); continue; }
      const fade = Math.pow(1 - rp.p, 2) * rp.strength;
      const rx = base * (0.4 + rp.p * 1.9);
      ctx.save();
      ctx.translate(cx, cy);
      ctx.beginPath();
      ctx.ellipse(0, 0, rx, rx * 0.30, 0, 0, Math.PI * 2);
      ctx.strokeStyle = "rgba(" + rgb + "," + (fade * 0.30).toFixed(3) + ")";
      ctx.lineWidth = 1.2;
      ctx.stroke();
      ctx.restore();
    }

    // ── the chest bloom: the one place the environment meets the figure, so
    // it stays soft. A light source, never a disc with an edge.
    const heart = base * (0.26 + amp * 0.18);
    const glow = ctx.createRadialGradient(cx, cy + base * 0.02, 0,
                                          cx, cy + base * 0.02, heart * 3.0);
    glow.addColorStop(0, "rgba(" + rgb + "," + (0.30 + amp * 0.34).toFixed(3) + ")");
    glow.addColorStop(0.4, "rgba(" + rgb + ",0.08)");
    glow.addColorStop(1, "rgba(" + rgb + ",0)");
    ctx.beginPath();
    ctx.arc(cx, cy + base * 0.02, heart * 3.0, 0, Math.PI * 2);
    ctx.fillStyle = glow;
    ctx.fill();

    requestAnimationFrame(frame);
  }

  addEventListener("resize", size);
  setTimeout(size, 0);
  // The stage resizes when the conversation starts, so re-measure after it settles.
  new ResizeObserver(size).observe(canvas.parentElement);
  // Deferred, because the loop reads `mic`, declared further down.
  requestAnimationFrame(frame);

  return {
    pulse: (value) => {
      ampTarget = Math.max(ampTarget, value);
      if (ripples.length < 4) ripples.push({ p: 0, strength: clamp(value, 0.2, 1) });
    },
  };
})();

/* ══════════════════════ microphone level ══════════════════════ */

const mic = {
  level: 0,
  ctx: null, analyser: null, stream: null, raf: null,

  async open() {
    if (this.stream) return true;
    try {
      this.stream = await navigator.mediaDevices.getUserMedia({
        audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true },
      });
      this.ctx = new (window.AudioContext || window.webkitAudioContext)();
      this.analyser = this.ctx.createAnalyser();
      this.analyser.fftSize = 512;
      this.ctx.createMediaStreamSource(this.stream).connect(this.analyser);

      const bins = new Uint8Array(this.analyser.frequencyBinCount);
      const read = () => {
        this.analyser.getByteFrequencyData(bins);
        let sum = 0;
        for (let i = 0; i < bins.length; i++) sum += bins[i] * bins[i];
        this.level = clamp(Math.sqrt(sum / bins.length) / 90, 0, 1.1);
        this.raf = requestAnimationFrame(read);
      };
      read();
      return true;
    } catch (_) {
      // The waveform is decorative — recognition still works without it.
      return false;
    }
  },

  close() {
    if (this.raf) cancelAnimationFrame(this.raf);
    this.raf = null;
    this.level = 0;
    if (this.stream) this.stream.getTracks().forEach((track) => track.stop());
    this.stream = null;
    if (this.ctx) this.ctx.close().catch(() => {});
    this.ctx = null;
  },
};

/* ══════════════════════ speech out ══════════════════════ */

const tts = {
  buffer: "",
  queue: [],
  speaking: false,
  voice: null,

  pickVoice() {
    const voices = speechSynthesis.getVoices();
    if (!voices.length) return;
    this.voice =
      voices.find((v) => /^en/i.test(v.lang) && /natural|neural|online/i.test(v.name)) ||
      voices.find((v) => /^en-(GB|US|IN)/i.test(v.lang)) ||
      voices.find((v) => /^en/i.test(v.lang)) || voices[0];
  },

  clean(text) {
    return text
      .replace(/```[\s\S]*?```/g, " ")
      .replace(/`([^`]*)`/g, "$1")
      .replace(/https?:\/\/\S+/g, "a link")
      .replace(/[*_#>|]/g, "")
      .replace(/\s+/g, " ")
      .trim();
  },

  /* Sentences are spoken as they complete, so the reply starts out loud
     while the model is still writing the rest of it. */
  feed(chunk) {
    if (state.muted || !("speechSynthesis" in window)) return;
    this.buffer += chunk;
    const parts = this.buffer.split(/(?<=[.!?…])\s+(?=[A-Z0-9"'“])|\n{2,}/);
    while (parts.length > 1) {
      const sentence = this.clean(parts.shift());
      if (sentence) this.queue.push(sentence);
    }
    this.buffer = parts[0] || "";
    this.pump();
  },

  flush() {
    if (state.muted) { this.buffer = ""; return; }
    const rest = this.clean(this.buffer);
    this.buffer = "";
    if (rest) { this.queue.push(rest); this.pump(); }
  },

  pump() {
    if (this.speaking || !this.queue.length || state.muted) return;
    const text = this.queue.shift();
    const utterance = new SpeechSynthesisUtterance(text.slice(0, 600));
    if (this.voice) utterance.voice = this.voice;
    utterance.rate = 1.05;
    utterance.pitch = 0.95;
    this.speaking = true;
    if (!state.busy) setState("speaking");

    /* Chrome can accept an utterance and then never fire a single event —
       it does this when speech has not been unlocked by a user gesture, and
       when a tab is throttled. Without a watchdog `speaking` would stay true
       forever and every later reply would be dropped in silence, so one
       blocked utterance would mute the whole session. */
    let settled = false;
    const done = (why) => {
      if (settled) return;
      settled = true;
      clearTimeout(watchdog);
      this.speaking = false;
      if (why === "blocked") this.report(false);
      if (this.queue.length) this.pump();
      else if (!state.busy) setState("idle");
    };
    const watchdog = setTimeout(() => {
      // Nothing started within a window far longer than any real start-up delay.
      if (!speechSynthesis.speaking && !speechSynthesis.pending) done("blocked");
    }, 1800);

    utterance.onstart = () => { clearTimeout(watchdog); this.report(true); };
    utterance.onend = () => done("end");
    utterance.onerror = (event) => {
      // "interrupted" and "canceled" are our own barge-in, not a failure.
      if (/interrupted|canceled|cancelled/i.test(event.error || "")) return done("end");
      this.lastError = event.error || "unknown";
      done("blocked");
    };

    try {
      speechSynthesis.speak(utterance);
    } catch (_) {
      done("blocked");
    }
  },

  /* Voice output failing silently is worse than it not existing, so the state
     is surfaced on the VOICE chip rather than left for the user to guess at. */
  report(working) {
    if (this.blocked === !working) return;
    this.blocked = !working;
    if (working) {
      if (voice.mode === "off") voice.setLink("off", "idle");
      el.linkVoice.title = "";
      return;
    }
    // `not-allowed` is the browser's own word for "no user activation, or this
    // tab is not visible" — by far the most common reason and the most fixable,
    // so say that rather than something vague.
    const activation = this.lastError === "not-allowed" || document.hidden;
    const why = activation
      ? "Voice output blocked — keep this tab visible and click the page once."
      : "Voice output failed (" + (this.lastError || "no response from the browser") + ").";
    voice.setLink("degraded", "output blocked");
    el.linkVoice.title = why;
    toast(why, "err");
  },

  /* Browsers only allow speech after a real user gesture. Speaking a silent
     utterance on the first interaction unlocks the engine for the session. */
  prime() {
    if (this.primed || !("speechSynthesis" in window)) return;
    this.primed = true;
    try {
      const warmup = new SpeechSynthesisUtterance(" ");
      warmup.volume = 0;
      speechSynthesis.speak(warmup);
    } catch (_) {
      /* Unlocking is best-effort; the watchdog reports it if it did not work. */
    }
  },

  stop() {
    this.buffer = "";
    this.queue = [];
    this.speaking = false;
    if ("speechSynthesis" in window) speechSynthesis.cancel();
  },
};

tts.blocked = null;
tts.primed = false;
tts.lastError = null;

// Any genuine interaction is enough to unlock speech; once is enough.
for (const kind of ["pointerdown", "keydown"]) {
  addEventListener(kind, () => tts.prime(), { once: true, capture: true });
}

// A hidden tab cannot speak. Coming back into view is a real chance for it to
// work again, so clear the blocked state and let the next reply try properly.
document.addEventListener("visibilitychange", () => {
  if (!document.hidden && tts.blocked) {
    tts.blocked = null;
    tts.lastError = null;
    if (voice.mode === "off") voice.setLink("off", "idle");
    el.linkVoice.title = "";
  }
});

if ("speechSynthesis" in window) {
  tts.pickVoice();
  speechSynthesis.onvoiceschanged = () => tts.pickVoice();
}

/* ══════════════════════ voice in ══════════════════════ */

const SR = window.SpeechRecognition || window.webkitSpeechRecognition;

const voice = {
  mode: "off",           // off | wake | command
  recognition: null,
  silence: null,
  command: "",
  restarting: false,

  setLink(status, text) {
    el.linkVoice.dataset.status = status;
    el.linkVoiceState.textContent = text;
  },

  init() {
    if (!SR) {
      el.mic.disabled = true;
      el.wake.disabled = true;
      el.mic.title = "Voice needs Chrome or Edge";
      this.setLink("off", "unsupported");
      return;
    }

    const recognition = new SR();
    recognition.lang = "en-IN";
    recognition.continuous = true;
    recognition.interimResults = true;
    this.recognition = recognition;

    recognition.onstart = () => { this.restarting = false; };

    // Someone started talking — stop whatever Jarvish is saying and listen.
    recognition.onspeechstart = () => {
      if (tts.speaking || tts.queue.length) {
        tts.stop();
        if (!state.busy) setState(this.mode === "command" ? "listening" : "idle");
      }
    };

    recognition.onresult = (event) => this.onResult(event);

    recognition.onerror = (event) => {
      if (event.error === "no-speech" || event.error === "aborted") return;
      const messages = {
        "not-allowed": "Microphone blocked — allow it for this page.",
        "service-not-allowed": "Microphone blocked by the browser.",
        "audio-capture": "No microphone found.",
      };
      toast(messages[event.error] || ("Voice error: " + event.error), "err");
      if (event.error === "not-allowed" || event.error === "audio-capture") this.off();
    };

    // Continuous recognition still stops on its own; bring it straight back.
    recognition.onend = () => {
      if (this.mode === "off" || this.restarting) return;
      this.restarting = true;
      setTimeout(() => {
        if (this.mode !== "off") {
          try { recognition.start(); } catch (_) { this.restarting = false; }
        }
      }, 220);
    };
  },

  onResult(event) {
    let interim = "", final = "";
    for (let i = event.resultIndex; i < event.results.length; i++) {
      const text = event.results[i][0].transcript;
      if (event.results[i].isFinal) final += text;
      else interim += text;
    }
    const heard = (final + " " + interim).toLowerCase();

    // "stop" / "abort" always wins, whatever mode we are in.
    if (/\b(stop|abort|cancel|emergency stop)\b/.test(heard) &&
        (state.busy || tts.speaking || tts.queue.length)) {
      emergencyStop("voice");
      this.command = "";
      el.input.value = "";
      return;
    }

    if (this.mode === "wake") {
      const index = heard.indexOf(state.wakeWord);
      if (index === -1) return;
      const rest = (final + " " + interim).slice(index + state.wakeWord.length)
        .replace(/^[\s,.!?:;-]+/, "");
      this.enterCommand(rest);
      return;
    }

    if (this.mode !== "command") return;

    if (final) this.command += (this.command ? " " : "") + final.trim();
    const shown = (this.command + " " + interim).trim();
    el.input.value = shown;
    autosize();
    this.armSilence();
  },

  enterCommand(seed) {
    this.mode = "command";
    this.command = (seed || "").trim();
    el.input.value = this.command;
    autosize();
    el.mic.classList.add("recording");
    this.setLink("live", "listening");
    setState("listening");
    coreView.pulse(0.85);
    mic.open();
    this.armSilence();
  },

  /* Auto-send once the user has been quiet for a beat. */
  armSilence(ms) {
    clearTimeout(this.silence);
    this.silence = setTimeout(() => {
      const text = (this.command || el.input.value).trim();
      this.command = "";
      if (text) {
        send(text);
        // Ambient mode goes back to waiting for the wake word.
        if (el.wake.getAttribute("aria-pressed") === "true") this.toWake();
        else this.off();
      } else {
        el.wake.getAttribute("aria-pressed") === "true" ? this.toWake() : this.off();
      }
    }, ms || 1400);
  },

  toWake() {
    clearTimeout(this.silence);
    this.mode = "wake";
    this.command = "";
    el.mic.classList.remove("recording");
    this.setLink("ok", "wake “" + state.wakeWord + "”");
    if (state.agent === "listening") setState("idle");
    this.start();
  },

  pushToTalk() {
    if (!SR) return toast("Voice needs Chrome or Edge", "err");
    if (this.mode === "command") { this.armSilence(1); return; }
    this.start();
    this.enterCommand("");
  },

  start() {
    if (!this.recognition) return;
    if (this.mode === "off") this.mode = "wake";
    try { this.recognition.start(); } catch (_) { /* already running */ }
  },

  off() {
    clearTimeout(this.silence);
    this.mode = "off";
    this.command = "";
    el.mic.classList.remove("recording");
    this.setLink("off", "idle");
    mic.close();
    if (this.recognition) { try { this.recognition.stop(); } catch (_) {} }
    if (state.agent === "listening") setState("idle");
  },
};

voice.init();

/* ══════════════════════ persistent voice (backend-owned) ══════════════════════ */

/* The microphone lives in the server process, not in this page. That is the
   whole point: a browser tab stops receiving audio the moment another window
   takes the foreground, so the HUD here only mirrors a state it does not own.
   Turning the mic on survives closing this tab; reopening it re-synchronises. */
const persistentVoice = {
  poll: null,
  lastReplyId: 0,
  state: "off",

  label(state) {
    return { off: "off", listening: "listening", processing: "thinking",
             speaking: "speaking", error: "error" }[state] || state;
  },

  tone(state) {
    return { off: "off", listening: "live", processing: "connecting",
             speaking: "ok", error: "offline" }[state] || "off";
  },

  apply(status) {
    if (!status || !status.ok) return;
    this.state = status.state;
    presence.pending = Boolean(status.pending);
    presence.sync();
    el.linkVoice.dataset.status = this.tone(status.state);
    el.linkVoiceState.textContent = this.label(status.state);
    el.mic.classList.toggle("recording", status.listening === true);
    el.mic.setAttribute("aria-pressed", String(status.listening === true));
    el.mic.title = status.listening
      ? "Listening — click to stop. Stays on while other apps are in front."
      : "Click to listen. The microphone belongs to the server, not this tab.";

    if (status.error && status.state === "error") {
      el.linkVoice.title = status.error;
    }

    /* Heard something: show it in the transcript as if it had been typed, so
       spoken and typed turns read as one conversation. */
    if (status.heard && status.heard !== this.lastHeard) {
      this.lastHeard = status.heard;
      addTurn("user", status.heard);
    }

    /* Speak each answer exactly once. The id increments per reply, so a poll
       that sees the same answer twice does not read it out twice. */
    if (status.reply_id && status.reply_id !== this.lastReplyId) {
      this.lastReplyId = status.reply_id;
      if (status.reply) {
        addTurn("assistant", status.reply);
        tts.feed(status.reply);
        tts.flush();
      } else {
        tts.stop();          // an empty reply on a new id means "stop talking"
      }
      fetch("/api/voice/spoken", { method: "POST" }).catch(() => {});
    }
  },

  async refresh() {
    try {
      this.apply(await (await fetch("/api/voice", { cache: "no-store" })).json());
    } catch (_) { /* server restarting; the next poll picks it up */ }
  },

  async toggle() {
    const turningOn = this.state === "off" || this.state === "error";
    el.linkVoiceState.textContent = turningOn ? "starting…" : "stopping…";
    try {
      const result = await (await fetch("/api/voice/" + (turningOn ? "start" : "stop"),
                                        { method: "POST" })).json();
      if (!result.ok) {
        toast(result.error || "Could not change the microphone", "err");
      } else if (turningOn) {
        toast("Listening — say “" + state.wakeWord + "”. Stays on across apps.");
      } else {
        toast("Microphone off");
      }
    } catch (_) {
      toast("Could not reach the microphone", "err");
    }
    this.refresh();
  },

  begin() {
    this.refresh();
    if (!this.poll) this.poll = setInterval(() => this.refresh(), 1200);
  },
};

/* ══════════════════════ humanoid presence ══════════════════════ */

/* Purely a mirror. It reads the agent state and the voice state that already
   exist and hands them to the renderer; it never decides anything, and if
   WebGL2 is unavailable the HUD carries on exactly as before. */
const presence = {
  live: false,

  begin() {
    const canvas = $("humanoid");
    const engine = window.jarvishHumanoid;
    if (!canvas || !engine) return;
    this.live = engine.init(canvas);
    window.__presence = this;
    if (!this.live) { canvas.hidden = true; return; }
    engine.assemble();          // cinematic gather on first paint
    this.sync();
  },

  sync() {
    if (!this.live) return;
    const engine = window.jarvishHumanoid;
    engine.setState(
      state.agent,
      persistentVoice.state,
      Boolean(state.pendingGate) || Boolean(presence.pending));
  },
};

/* ══════════════════════ transcript rendering ══════════════════════ */

function renderMarkdown(text) {
  const blocks = [];
  let out = text.replace(/```(\w*)\n?([\s\S]*?)```/g, (_, lang, code) => {
    blocks.push('<pre><code class="' + esc(lang) + '">' +
                esc(code.replace(/\n$/, "")) + "</code></pre>");
    return " BLOCK" + (blocks.length - 1) + " ";
  });

  out = esc(out)
    .replace(/`([^`\n]+)`/g, "<code>$1</code>")
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
    .replace(/(^|[\s(])\*([^*\n]+)\*/g, "$1<em>$2</em>")
    .replace(/(https?:\/\/[^\s<)]+)/g, '<a href="$1" target="_blank" rel="noopener">$1</a>');

  out = out.split(/\n{2,}/).map((para) => {
    const lines = para.split("\n").filter((line) => line.trim());
    if (!lines.length) return "";
    if (lines.every((line) => /^\s*[-*]\s+/.test(line))) {
      return "<ul>" + lines.map((l) => "<li>" + l.replace(/^\s*[-*]\s+/, "") + "</li>").join("") + "</ul>";
    }
    if (lines.every((line) => /^\s*\d+[.)]\s+/.test(line))) {
      return "<ol>" + lines.map((l) => "<li>" + l.replace(/^\s*\d+[.)]\s+/, "") + "</li>").join("") + "</ol>";
    }
    return "<p>" + lines.join("<br>") + "</p>";
  }).join("");

  return out.replace(/ ?BLOCK(\d+) ?/g, (_, i) => blocks[i]);
}

const atBottom = () =>
  el.transcript.scrollHeight - el.transcript.scrollTop - el.transcript.clientHeight < 140;

function scrollDown(force) {
  if (force || atBottom()) el.transcript.scrollTop = el.transcript.scrollHeight;
}

function addTurn(role, text) {
  el.hud.classList.add("engaged");
  const turn = document.createElement("div");
  turn.className = "turn " + role;

  const who = document.createElement("span");
  who.className = "who";
  who.textContent = role === "user" ? "YOU" : "JARVISH";

  const strip = document.createElement("div");
  strip.className = "tool-strip";
  strip.hidden = true;

  const bubble = document.createElement("div");
  bubble.className = "bubble";
  bubble.innerHTML = renderMarkdown(text || "");

  turn.append(who, strip, bubble);
  el.transcript.appendChild(turn);
  scrollDown(true);
  return { turn, strip, bubble };
}

function addNotice(title, detail) {
  el.hud.classList.add("engaged");
  const node = document.createElement("div");
  node.className = "notice";
  node.innerHTML = "<b>" + esc(title) + "</b>" + detail;
  el.transcript.appendChild(node);
  scrollDown(true);
}

function summarise(args) {
  return Object.entries(args || {})
    .filter(([, v]) => v !== null && v !== "" && v !== undefined)
    .map(([k, v]) => {
      const value = typeof v === "string" ? v : JSON.stringify(v);
      return k + "=" + (value.length > 34 ? value.slice(0, 34) + "…" : value);
    }).join(" ");
}

function addChip(strip, event) {
  strip.hidden = false;
  const chip = document.createElement("div");
  chip.className = "chip";
  chip.dataset.risk = event.risk || "safe";
  chip.innerHTML =
    '<span class="spark"></span><b></b><span class="args"></span><span class="ms"></span>';
  chip.querySelector("b").textContent = event.name;
  chip.querySelector(".args").textContent = summarise(event.arguments);

  let detail = null;
  chip.addEventListener("click", () => {
    if (detail) { detail.remove(); detail = null; return; }
    detail = document.createElement("div");
    detail.className = "chip-detail";
    detail.textContent = chip.dataset.payload || "no result yet";
    chip.after(detail);
    scrollDown(false);
  });

  strip.appendChild(chip);
  scrollDown(false);
  return chip;
}

/* ══════════════════════ pipeline graph ══════════════════════ */

const pipeline = {
  nodes: new Map(),

  reset() {
    this.nodes.clear();
    el.track.innerHTML = "";
    el.pipeline.hidden = true;
  },

  plan(steps) {
    el.pipeline.hidden = false;
    for (const step of steps) this.add(step.name, step.risk);
  },

  add(name, risk) {
    if (el.track.children.length) {
      const link = document.createElement("span");
      link.className = "link-line";
      el.track.appendChild(link);
    }
    const node = document.createElement("span");
    node.className = "node";
    node.dataset.risk = risk || "safe";
    node.innerHTML = '<span class="pip"></span><span class="node-name"></span>';
    node.querySelector(".node-name").textContent = name;
    el.track.appendChild(node);
    el.pipeline.scrollLeft = el.pipeline.scrollWidth;
    return node;
  },

  /* The plan lists names; a running call binds to the first free node of
     that name, so repeated tools light up in the order they actually ran. */
  bind(id, name, risk) {
    let node = [...el.track.querySelectorAll(".node")].find(
      (candidate) => candidate.querySelector(".node-name").textContent === name &&
                     !candidate.dataset.bound);
    if (!node) { el.pipeline.hidden = false; node = this.add(name, risk); }
    node.dataset.bound = id;
    node.classList.add("active");
    this.nodes.set(id, node);
    el.pipeline.scrollLeft = el.pipeline.scrollWidth;
  },

  settle(id, status) {
    const node = this.nodes.get(id);
    if (!node) return;
    node.classList.remove("active");
    node.classList.add(status);
  },
};

/* ══════════════════════ activity stream ══════════════════════ */

function logEvent(kind, headline, detail) {
  const first = el.stream.querySelector(".dim");
  if (first) first.remove();

  const row = document.createElement("div");
  row.className = "event";
  row.dataset.kind = kind;
  row.innerHTML = "<time></time><span class='what'><b></b> <span></span></span>";
  row.querySelector("time").textContent = clock();
  row.querySelector("b").textContent = headline;
  row.querySelector(".what span").textContent = detail || "";
  el.stream.appendChild(row);

  while (el.stream.children.length > 220) el.stream.firstChild.remove();
  el.stream.scrollTop = el.stream.scrollHeight;
  el.activityCount.textContent = ++state.events;
}

/* ══════════════════════ telemetry ══════════════════════ */

const netHistory = { up: [], down: [] };

function drawNet() {
  const canvas = el.netgraph;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const width = canvas.clientWidth || 240;
  const height = 54;
  if (canvas.width !== width * dpr) {
    canvas.width = width * dpr;
    canvas.height = height * dpr;
  }
  const ctx = canvas.getContext("2d");
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, width, height);

  const peak = Math.max(64 * 1024, ...netHistory.up, ...netHistory.down);
  const plot = (series, colour, fill) => {
    if (series.length < 2) return;
    ctx.beginPath();
    series.forEach((value, i) => {
      const x = (i / (series.length - 1)) * width;
      // Log scaling, so a trickle is still visible next to a burst.
      const y = height - (Math.log10(1 + value) / Math.log10(1 + peak)) * (height - 4) - 2;
      i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
    });
    ctx.strokeStyle = colour;
    ctx.lineWidth = 1.3;
    ctx.stroke();
    ctx.lineTo(width, height);
    ctx.lineTo(0, height);
    ctx.closePath();
    ctx.fillStyle = fill;
    ctx.fill();
  };

  plot(netHistory.down, "rgba(34,211,238,.75)", "rgba(34,211,238,.09)");
  plot(netHistory.up, "rgba(139,92,246,.7)", "rgba(139,92,246,.07)");
}

function setGauge(metric, value) {
  const gauge = el.gauges.querySelector('.gauge[data-metric="' + metric + '"]');
  if (!gauge) return;
  const circumference = 2 * Math.PI * 28;
  gauge.querySelector(".arc").style.strokeDashoffset =
    circumference * (1 - clamp(value, 0, 100) / 100);
  gauge.querySelector(".gauge-val").textContent = Math.round(value);
  gauge.dataset.load = value >= 90 ? "crit" : value >= 75 ? "warn" : "ok";
}

function applyTelemetry(frame) {
  setGauge("cpu", frame.cpu);
  setGauge("memory", frame.memory);
  setGauge("disk", frame.disk);

  el.rMem.textContent = frame.memory_used_gb + " / " + frame.memory_total_gb + " GB";
  el.rDisk.textContent = frame.disk_free_gb + " GB";
  el.rProc.textContent = frame.processes;
  el.rBatt.textContent = frame.battery
    ? frame.battery.percent + "%" + (frame.battery.plugged ? " ⚡" : "")
    : "AC";
  el.rUptime.textContent = "up " + duration(frame.uptime);
  el.rDown.textContent = bytes(frame.net_down);
  el.rUp.textContent = bytes(frame.net_up);

  netHistory.down.push(frame.net_down);
  netHistory.up.push(frame.net_up);
  if (netHistory.down.length > 90) { netHistory.down.shift(); netHistory.up.shift(); }
  drawNet();

  el.insights.innerHTML = "";
  el.insights.hidden = !frame.insights || !frame.insights.length;
  for (const note of frame.insights || []) {
    const row = document.createElement("div");
    row.className = "insight " + (note.severity === "critical" ? "critical" : "");
    row.textContent = note.text;
    el.insights.appendChild(row);
  }

  if (frame.top) {
    el.procList.innerHTML = "";
    for (const process of frame.top) {
      const row = document.createElement("div");
      row.className = "proc";
      row.innerHTML =
        '<span class="proc-name"></span><span class="proc-val"></span>' +
        '<span class="proc-bar"><i></i></span>';
      row.querySelector(".proc-name").textContent = process.name;
      row.querySelector(".proc-val").textContent = process.memory + "%";
      row.querySelector(".proc-bar i").style.width = clamp(process.memory * 4, 2, 100) + "%";
      el.procList.appendChild(row);
    }
  }
}

let telemetrySource = null;

function openTelemetry() {
  // Replace rather than add: calling this again after a reconnect would
  // otherwise leave two streams open, doubling the frame rate and quietly
  // eating one of the browser's six connections to this host.
  if (telemetrySource) {
    try { telemetrySource.close(); } catch (_) { /* already gone */ }
  }
  telemetrySource = new EventSource("/api/telemetry/stream");
  telemetrySource.onmessage = (event) => {
    try { applyTelemetry(JSON.parse(event.data)); } catch (_) { /* skip a bad frame */ }
  };
  telemetrySource.onerror = () => {
    // EventSource reconnects on its own; just show the gap.
    el.linkNet.dataset.status = "degraded";
  };
}

/* ══════════════════════ vision panel ══════════════════════ */

const visionPanel = {
  /* Draw a captured frame with its grounded elements boxed over the top.
     Boxes are placed in percentages of the frame's own pixel dimensions, so
     they stay aligned however the panel is sized. */
  show(result) {
    const frame = result.frame;
    if (!frame || !frame.view_url) return;

    el.visionPanel.hidden = false;
    // Cache-bust: successive captures reuse the panel, and the filenames are
    // unique, but a redraw of the same frame should not refetch.
    if (el.visionShot.dataset.url !== frame.view_url) {
      el.visionShot.src = frame.view_url;
      el.visionShot.dataset.url = frame.view_url;
    }

    const mode = result.mode || (result.matches ? "locate" : "observe");
    el.visionMode.textContent = mode.toUpperCase();
    el.visionMode.dataset.mode = mode;

    const elements = result.elements || result.matches || [];
    const best = result.best;
    const originX = (frame.origin && frame.origin.x) || 0;
    const originY = (frame.origin && frame.origin.y) || 0;

    el.visionBoxes.innerHTML = "";
    for (const item of elements.slice(0, 60)) {
      if (!item.w || !item.h) continue;
      const box = document.createElement("div");
      box.className = "box";
      box.dataset.source = item.source || "uia";
      box.dataset.interactive = String(!!item.interactive);
      if (best && item.id === best.id) box.dataset.best = "true";
      box.style.left = ((item.x - originX) / frame.width * 100) + "%";
      box.style.top = ((item.y - originY) / frame.height * 100) + "%";
      box.style.width = (item.w / frame.width * 100) + "%";
      box.style.height = (item.h / frame.height * 100) + "%";
      if (item.text && item.w / frame.width > 0.05) {
        const label = document.createElement("b");
        label.textContent = item.text.slice(0, 26);
        box.appendChild(label);
      }
      el.visionBoxes.appendChild(box);
    }

    const window_ = result.window || {};
    const uia = elements.filter((e) => e.source === "uia").length;
    const ocr = elements.filter((e) => e.source === "ocr").length;
    el.visionMeta.innerHTML = "";
    const facts = [
      ["WINDOW", (window_.title || "unknown").slice(0, 30), ""],
      ["UIA", uia, "uia"],
      ["OCR", ocr, "ocr"],
      ["SIZE", frame.width + "×" + frame.height, ""],
    ];
    if (result.vision_model) facts.push(["MODEL", result.vision_model, ""]);
    for (const [key, value, cls] of facts) {
      const span = document.createElement("span");
      span.className = cls;
      span.innerHTML = "<b></b> <span></span>";
      span.querySelector("b").textContent = key;
      span.querySelector("span").textContent = value;
      el.visionMeta.appendChild(span);
    }

    // A degraded result must say so on the panel, not just in the transcript.
    const note = result.limitation || result.note;
    el.visionNote.hidden = !(result.degraded && note);
    if (result.degraded && note) el.visionNote.textContent = note;

    logEvent("state", "Vision", mode + " · " + uia + " UIA + " + ocr + " OCR");
  },

  clear() {
    el.visionPanel.hidden = true;
    el.visionBoxes.innerHTML = "";
    el.visionShot.removeAttribute("src");
    delete el.visionShot.dataset.url;
  },
};

async function refreshVision() {
  try {
    const status = await (await fetch("/api/vision/status")).json();
    const caps = status.capabilities || {};
    const working = caps.capture && caps.ocr && caps.ui_tree;
    if (!caps.enabled) {
      el.linkVision.dataset.status = "off";
      el.linkVisionState.textContent = "disabled";
    } else if (status.vision_available) {
      el.linkVision.dataset.status = "ok";
      el.linkVisionState.textContent = status.vision_model;
    } else if (working) {
      // Capture, OCR and grounding all work — only image interpretation is out.
      el.linkVision.dataset.status = "degraded";
      el.linkVisionState.textContent = "text only";
      el.linkVision.title = status.limitation || "";
    } else {
      el.linkVision.dataset.status = "offline";
      el.linkVisionState.textContent = "unavailable";
    }
  } catch (_) {
    el.linkVision.dataset.status = "offline";
    el.linkVisionState.textContent = "unknown";
  }
}

/* ══════════════════════ mission control ══════════════════════ */

const MARKS = {
  completed: "✓", running: "●", pending: "○",
  failed: "✕", blocked: "✕", cancelled: "–",
  waiting_approval: "◑",
};

const mission = {
  showing: null,

  /* Only one mission is shown at a time — the live one, or the most recent.
     A wall of finished missions is history, not control. */
  pick(list) {
    const active = list.find((m) => m.state === "running") ||
                   list.find((m) => m.state === "paused");
    return active || list[0] || null;
  },

  async refresh() {
    let list;
    try {
      list = (await (await fetch("/api/missions")).json()).missions || [];
    } catch (_) {
      el.linkMission.dataset.status = "offline";
      el.linkMissionState.textContent = "unknown";
      return;
    }

    const running = list.filter((m) => m.state === "running").length;
    const paused = list.filter((m) => m.state === "paused").length;
    el.linkMission.dataset.status = running ? "live" : (paused ? "degraded" : "off");
    el.linkMissionState.textContent = running
      ? running + " running"
      : (paused ? paused + " paused" : (list.length ? "idle" : "none"));

    const chosen = this.pick(list);
    if (!chosen) {
      el.missionPanel.hidden = true;
      this.showing = null;
      return;
    }
    // Finished missions stop occupying the panel once they are old news.
    if (["completed", "failed", "cancelled"].includes(chosen.state) &&
        this.showing !== chosen.id) {
      el.missionPanel.hidden = true;
      return;
    }

    let detail;
    try {
      detail = await (await fetch("/api/missions/" + chosen.id)).json();
    } catch (_) {
      return;
    }
    if (!detail.ok) return;
    this.showing = chosen.id;
    this.render(detail);
  },

  render(m) {
    el.missionPanel.hidden = false;
    el.missionGoal.textContent = m.goal;
    el.missionState.textContent = (m.state || "").toUpperCase();
    el.missionState.dataset.state = m.state;

    el.missionFill.style.width = (m.progress || 0) + "%";
    const done = (m.tasks || []).filter((t) => t.state === "completed").length;
    el.missionProgress.textContent =
      m.progress + "% · " + done + " of " + (m.tasks || []).length + " steps";

    el.missionTasks.innerHTML = "";
    for (const task of m.tasks || []) {
      const row = document.createElement("div");
      row.className = "mtask";
      row.dataset.state = task.state;
      row.innerHTML = '<span class="mark"></span><span class="title"></span>' +
                      '<span class="agent"></span>';
      row.querySelector(".mark").textContent = MARKS[task.state] || "○";
      row.querySelector(".title").textContent = task.title;
      row.querySelector(".agent").textContent = task.agent;
      row.title = task.error || task.result || task.state;
      el.missionTasks.appendChild(row);
    }

    const waiting = (m.awaiting_approval || [])[0];
    if (waiting) {
      el.missionCurrent.hidden = false;
      el.missionCurrent.dataset.waiting = "true";
      el.missionCurrent.textContent =
        "Waiting for permission: " + waiting.title;
    } else if (m.current) {
      el.missionCurrent.hidden = false;
      el.missionCurrent.dataset.waiting = "false";
      el.missionCurrent.textContent =
        m.current + (m.current_agent ? "  (" + m.current_agent + " agent)" : "");
    } else if (m.result && ["completed", "failed"].includes(m.state)) {
      el.missionCurrent.hidden = false;
      el.missionCurrent.dataset.waiting = "false";
      el.missionCurrent.textContent = m.result.slice(0, 400);
    } else {
      // Clear as well as hide: stale text would reappear on the next render.
      el.missionCurrent.hidden = true;
      el.missionCurrent.textContent = "";
    }

    el.missionActions.innerHTML = "";
    const buttons = m.state === "running" ? [["pause", "PAUSE"], ["cancel", "CANCEL"]]
                  : m.state === "paused" ? [["resume", "RESUME"], ["cancel", "CANCEL"]]
                  : [];
    for (const pair of buttons) {
      const button = document.createElement("button");
      button.textContent = pair[1];
      button.addEventListener("click", () => this.act(pair[0], m.mission));
      el.missionActions.appendChild(button);
    }
    if (!buttons.length) el.missionActions.innerHTML = "";
  },

  async act(action, missionId) {
    try {
      await fetch("/api/missions/action/" + action, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ mission: missionId }),
      });
      toast("Mission " + action + "d");
      this.refresh();
    } catch (_) {
      toast("Could not " + action + " the mission", "err");
    }
  },
};

/* ══════════════════════ capability registry ══════════════════════ */

const registry = {
  /* The full list is long and mostly built-ins, so the panel leads with what
     is actually interesting: plugins, and anything unhealthy or unavailable. */
  render(manifest) {
    const all = manifest.capabilities || [];
    const notable = all.filter(
      (c) => c.source !== "builtin" ||
             c.health === "unhealthy" || c.available === false);

    el.capsCount.textContent = manifest.count
      ? notable.length + " of " + manifest.count : "";

    el.caps.innerHTML = "";
    for (const cap of notable.slice(0, 14)) {
      const card = document.createElement("div");
      card.className = "cap";
      // /api/registry returns health as {status, checked_at, detail}; the
      // list_capabilities tool flattens it to a string. Accept either.
      const health = (cap.health && typeof cap.health === "object")
        ? cap.health.status : cap.health;
      card.dataset.health = cap.available === false ? "unavailable" : (health || "unknown");
      card.dataset.enabled = String(cap.enabled !== false);
      card.innerHTML =
        '<div class="cap-head"><b></b><span class="ver"></span>' +
        '<span class="kind"></span></div><div class="cap-meta"></div>' +
        '<div class="cap-why"></div>';
      card.querySelector("b").textContent = cap.name;
      card.querySelector(".ver").textContent = cap.version ? "v" + cap.version : "";
      card.querySelector(".kind").textContent = (cap.kind || "").toUpperCase();

      const meta = card.querySelector(".cap-meta");
      const riskTag = document.createElement("span");
      riskTag.className = "cap-tag";
      riskTag.dataset.risk = cap.risk;
      riskTag.textContent = (cap.risk || "").toUpperCase();
      meta.appendChild(riskTag);
      for (const scope of cap.permissions || []) {
        const tag = document.createElement("span");
        tag.className = "cap-tag";
        tag.dataset.scope = scope;
        tag.textContent = scope;
        meta.appendChild(tag);
      }
      if (cap.enabled === false) {
        const tag = document.createElement("span");
        tag.className = "cap-tag";
        tag.textContent = "disabled";
        meta.appendChild(tag);
      }

      const why = card.querySelector(".cap-why");
      const reason = cap.unavailable_reason ||
                     (health === "unhealthy" ? "Health check failed." : null);
      if (reason) why.textContent = reason;
      else why.remove();

      el.caps.appendChild(card);
    }

    if (!notable.length) {
      const empty = document.createElement("p");
      empty.className = "dim";
      empty.textContent = manifest.count + " built-in capabilities, no plugins loaded.";
      el.caps.appendChild(empty);
    }

    const failed = Object.entries(manifest.plugins || {})
      .filter(([, info]) => !info.loaded);
    el.capsNote.hidden = failed.length === 0;
    if (failed.length) {
      el.capsNote.textContent = failed
        .map(([name, info]) => name + ": " + info.error).join("  ·  ");
    }

    el.capsPanel.hidden = false;
  },

  async refresh(show) {
    try {
      const manifest = await (await fetch("/api/registry")).json();
      const plugins = Object.values(manifest.plugins || {});
      const broken = plugins.filter((p) => !p.loaded).length;
      const unhealthy = (manifest.health || {}).unhealthy || 0;

      el.linkPlugins.dataset.status =
        broken || unhealthy ? "degraded" : (plugins.length ? "ok" : "off");
      el.linkPluginsState.textContent = plugins.length
        ? plugins.length + " loaded" + (broken ? " · " + broken + " failed" : "")
        : manifest.count + " built-in";
      el.linkPlugins.title = "Jarvish " + manifest.jarvish_version + " · " +
        manifest.count + " capabilities";

      if (show || broken || unhealthy) this.render(manifest);
      return manifest;
    } catch (_) {
      el.linkPlugins.dataset.status = "offline";
      el.linkPluginsState.textContent = "unknown";
    }
  },
};

el.reloadPlugins.addEventListener("click", async () => {
  try {
    const result = await (await fetch("/api/registry/action/reload", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({}),
    })).json();
    const failed = (result.failed || []).length;
    toast(failed ? "Reloaded — " + failed + " plugin(s) failed"
                 : "Plugins reloaded", failed ? "err" : "");
    registry.refresh(true);
  } catch (_) {
    toast("Could not reload plugins", "err");
  }
});

/* ══════════════════════ autonomy ══════════════════════ */

/* How much Jarvish may do without asking. This is a ceiling over the risk gate,
   never a bypass, so the panel says so plainly — a user who raises the level to
   stop being interrupted needs to know that irreversible actions will still
   stop, and a user who is being interrupted needs to see that the level, not
   the risk of the action, is what is in the way. */
const autonomy = {
  level: null,
  levels: {},
  missions: false,

  /* Rising trust reads as rising temperature: dim below, live in the middle,
     amber at the top where high-risk actions run unasked. */
  tone(level) {
    if (level <= 0) return "off";
    if (level <= 2) return "ok";
    if (level <= 4) return "live";
    return "degraded";
  },

  apply(status) {
    if (!status || !status.ok) return;
    this.level = status.level;
    this.levels = status.levels || this.levels;
    this.missions = !!status.missions_allowed;

    el.linkAutonomy.dataset.status = this.tone(status.level);
    el.linkAutonomyState.textContent = "L" + status.level + " " + status.name.toLowerCase();
    el.linkAutonomy.title = status.detail + "  Runs without asking: " +
      status.runs_without_asking + ".";

    el.autonomyName.textContent = "L" + status.level + " · " + status.name;
    // POST /api/autonomy answers with the new level but not the standing note,
    // so keep whatever is already there rather than blanking it.
    if (status.note) el.autonomyNote.textContent = status.note;
    this.render();
  },

  render() {
    el.autonomyLevels.innerHTML = "";
    for (const key of Object.keys(this.levels).sort((a, b) => a - b)) {
      const level = Number(key);
      const spec = this.levels[key];
      const row = document.createElement("button");
      row.className = "autonomy-level";
      row.type = "button";
      row.dataset.tone = this.tone(level);
      row.dataset.current = String(level === this.level);
      row.setAttribute("aria-pressed", String(level === this.level));
      row.innerHTML = '<span class="al-key"></span><span class="al-body">' +
                      '<b></b><em></em></span>';
      row.querySelector(".al-key").textContent = "L" + level;
      row.querySelector("b").textContent = spec.name;
      row.querySelector("em").textContent = spec.detail;
      row.addEventListener("click", () => this.set(level));
      el.autonomyLevels.appendChild(row);
    }
  },

  async set(level) {
    if (level === this.level) return;
    try {
      const result = await (await fetch("/api/autonomy", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ level }),
      })).json();
      if (!result.ok) { toast(result.error || "Level refused", "err"); return; }
      toast("Autonomy L" + result.level + " — " + result.name);
      logEvent("state", "Autonomy set to L" + result.level, result.name);
      await this.refresh();
    } catch (_) {
      toast("Could not change the autonomy level", "err");
    }
  },

  async refresh() {
    try {
      this.apply(await (await fetch("/api/autonomy")).json());
    } catch (_) {
      el.linkAutonomy.dataset.status = "offline";
      el.linkAutonomyState.textContent = "unknown";
    }
  },
};

/* ══════════════════════ developer panel ══════════════════════ */

/* A fix moves through these; the panel shows where it has got to. */
const FIX_STAGES = ["DIAGNOSE", "EDIT", "TEST", "VERIFY"];

const developer = {
  facts: new Map(),
  stage: null,

  set(key, value, tone) {
    if (value === undefined || value === null || value === "") return;
    this.facts.set(key, { value: String(value), tone: tone || null });
  },

  /* Read whatever a developer tool returned and keep the parts worth showing.
     Only tools that actually ran contribute, so nothing here is speculative. */
  absorb(name, result) {
    if (!result || result.ok === false) {
      if (name === "run_tests" || name === "run_build") {
        this.set("STATUS", result && result.error ? result.error : "failed", "bad");
        this.show();
      }
      return;
    }

    switch (name) {
      case "project_info":
      case "project_architecture": {
        const root = (result.root || "").split(/[\\/]/).pop();
        this.set("PROJECT", root);
        this.set("STACK", (result.languages || []).concat(result.frameworks || [])
                            .slice(0, 3).join(", "));
        if (result.commands && result.commands.test) {
          this.set("TESTS", result.commands.test);
        }
        break;
      }

      case "diagnose_error": {
        this.stage = "DIAGNOSE";
        if (result.classified) {
          this.set("ERROR", (result.exception || result.kind) +
                            (result.message ? ": " + result.message : ""), "bad");
          const site = result.likely_site;
          if (site) {
            this.set("SITE", (site.path || "").split(/[\\/]/).pop() +
                             (site.line ? ":" + site.line : "") +
                             (site.function ? "  in " + site.function : ""));
          }
          this.set("CONFIDENT", result.confident ? "located" : "not located",
                   result.confident ? "good" : "warn");
          const first = (result.evidence || [])[0];
          el.devEvidence.hidden = !first;
          if (first) el.devEvidence.textContent = first.excerpt;
        } else {
          this.set("ERROR", "not recognised", "warn");
          el.devEvidence.hidden = true;
        }
        break;
      }

      case "find_callers":
        this.set("SYMBOL", result.symbol + " · " + result.caller_count + " caller" +
                           (result.caller_count === 1 ? "" : "s"));
        break;

      case "find_dependents":
        this.set("MODULE", result.module + " · imported by " + result.count);
        break;

      case "propose_change":
        this.stage = "EDIT";
        if (result.proposal) {
          this.set("CHANGE", (result.proposal.files || [])
                     .map((f) => f.split(/[\\/]/).pop()).join(", ") + "  (proposed)",
                   "warn");
          this.set("RISK", result.proposal.risk);
        }
        break;

      case "apply_change":
        this.stage = "TEST";
        this.set("CHANGE", (result.changed || "").split(/[\\/]/).pop() + "  (applied)",
                 result.verified ? "good" : "warn");
        break;

      case "revert_change":
        this.set("CHANGE", (result.restored || "").split(/[\\/]/).pop() + "  (reverted)",
                 "warn");
        break;

      case "run_tests": {
        this.stage = "VERIFY";
        const s = result.summary || {};
        const bits = [];
        if (s.passed !== null && s.passed !== undefined) bits.push(s.passed + " passed");
        if (s.failed) bits.push(s.failed + " failed");
        if (s.errors) bits.push(s.errors + " errors");
        this.set("TESTS", bits.join(", ") || (result.succeeded ? "green" : "red"),
                 s.green ? "good" : "bad");
        if (result.failures && result.failures.length) {
          this.set("FAILING", result.failures[0].test, "bad");
        }
        break;
      }

      case "run_build":
        this.set("BUILD", result.succeeded ? "succeeded" : "failed",
                 result.succeeded ? "good" : "bad");
        break;

      case "run_dev_command":
        this.set("COMMAND", result.command);
        this.set("RESULT", result.succeeded ? "exit 0" : "exit " + result.exit_code,
                 result.succeeded ? "good" : "bad");
        break;

      case "git_status":
        this.set("GIT", (result.branch || "?") + " · " +
                        (result.clean ? "clean" : result.changed_files + " changed"),
                 result.clean ? "good" : "warn");
        break;

      case "git_log":
        if (result.commits && result.commits.length) {
          this.set("COMMIT", result.commits[0].hash + " " + result.commits[0].subject);
        }
        break;

      case "propose_commit":
        this.set("COMMIT", result.nothing_to_commit
                   ? "nothing to commit"
                   : result.file_count + " file(s): " + result.proposed_message,
                 "warn");
        break;

      default:
        return;
    }
    this.show();
  },

  show() {
    if (!this.facts.size) return;
    el.devPanel.hidden = false;

    el.devRows.innerHTML = "";
    for (const [key, entry] of this.facts) {
      const row = document.createElement("div");
      row.className = "dev-row";
      if (entry.tone) row.dataset.tone = entry.tone;
      row.innerHTML = "<b></b><span></span>";
      row.querySelector("b").textContent = key;
      row.querySelector("span").textContent = entry.value;
      el.devRows.appendChild(row);
    }

    if (this.stage) {
      const strip = document.createElement("div");
      strip.className = "dev-stages";
      const reached = FIX_STAGES.indexOf(this.stage);
      FIX_STAGES.forEach((label, index) => {
        const chip = document.createElement("span");
        chip.className = "dev-stage-chip";
        chip.textContent = label;
        if (index === reached) chip.dataset.active = "true";
        else if (index < reached) chip.dataset.done = "true";
        strip.appendChild(chip);
      });
      el.devRows.appendChild(strip);
      el.devStage.textContent = this.stage;
      el.devStage.dataset.tone =
        this.stage === "VERIFY" ? "good" : (this.stage === "DIAGNOSE" ? "bad" : "");
    }
  },

  clear() {
    this.facts.clear();
    this.stage = null;
    el.devPanel.hidden = true;
    el.devRows.innerHTML = "";
    el.devEvidence.hidden = true;
  },
};

/* ══════════════════════ proactive: alerts and tasks ══════════════════════ */

const LEVEL_ORDER = ["info", "low", "medium", "high", "critical"];

const proactive = {
  quiet: false,
  announced: new Set(),

  /* Panels appear only when there is something to show. An empty alerts panel
     is just furniture. */
  render(payload) {
    const items = payload.notifications || [];
    el.alertsPanel.hidden = items.length === 0;
    el.alertCount.textContent = items.length
      ? items.length + (payload.unseen ? " · " + payload.unseen + " new" : "")
      : "";

    el.alerts.innerHTML = "";
    for (const item of items.slice(0, 10)) {
      const card = document.createElement("div");
      card.className = "alert";
      card.dataset.level = item.level;
      card.dataset.seen = String(item.seen);
      card.innerHTML =
        '<div class="alert-head"><b></b><span class="level"></span></div>' +
        '<div class="alert-msg"></div><div class="alert-fix"></div>';
      card.querySelector("b").textContent = item.title;
      card.querySelector(".level").textContent = item.level.toUpperCase();
      card.querySelector(".alert-msg").textContent = item.message;
      const fix = card.querySelector(".alert-fix");
      if (item.suggestion) fix.textContent = item.suggestion;
      else fix.remove();
      el.alerts.appendChild(card);

      /* Toast only genuinely urgent things, and only once each — the server
         already suppresses repeats, this stops a re-render re-announcing. */
      if (!item.seen && !this.announced.has(item.key) &&
          LEVEL_ORDER.indexOf(item.level) >= LEVEL_ORDER.indexOf("high")) {
        this.announced.add(item.key);
        toast(item.title + " — " + item.message, "err");
      }
    }

    const settings = payload.settings || {};
    this.quiet = !!settings.quiet;
    el.quietBtn.setAttribute("aria-pressed", String(this.quiet));
    el.quietBtn.title = this.quiet ? "Quiet mode is on" : "Quiet mode";

    const monitor = payload.monitor || {};
    if (!settings.enabled) {
      el.linkWatch.dataset.status = "off";
      el.linkWatchState.textContent = "off";
    } else if (monitor.running) {
      el.linkWatch.dataset.status = this.quiet ? "degraded" : "ok";
      el.linkWatchState.textContent = this.quiet
        ? "quiet"
        : (items.length ? items.length + " alert" + (items.length === 1 ? "" : "s")
                        : "watching");
    } else {
      el.linkWatch.dataset.status = "offline";
      el.linkWatchState.textContent = "stopped";
    }
  },

  renderTasks(payload) {
    const all = payload.tasks || [];
    const active = all.filter((t) => ["running", "pending", "paused"].includes(t.state));
    const recent = all.filter((t) => ["completed", "failed"].includes(t.state)).slice(0, 2);
    const shown = active.concat(recent);

    el.tasksPanel.hidden = shown.length === 0;
    el.taskCount.textContent = active.length ? active.length + " active" : "";

    el.tasks.innerHTML = "";
    for (const task of shown.slice(0, 8)) {
      const card = document.createElement("div");
      card.className = "task";
      card.dataset.state = task.state;
      card.innerHTML =
        '<div class="task-head"><b></b><span class="state"></span></div>' +
        '<div class="task-progress"></div><div class="task-bar"><i></i></div>' +
        '<div class="task-actions"></div>';
      card.querySelector("b").textContent = task.title;
      card.querySelector(".state").textContent = task.state.toUpperCase();
      card.querySelector(".task-progress").textContent =
        task.error ? task.error : (task.progress || "");
      if (task.state !== "running") card.querySelector(".task-bar").remove();

      const actions = card.querySelector(".task-actions");
      const buttons =
        task.state === "paused" ? [["resume", "RESUME"], ["cancel", "CANCEL"]]
        : task.state === "failed" ? [["retry", "RETRY"], ["cancel", "CANCEL"]]
        : ["running", "pending"].includes(task.state)
          ? [["pause", "PAUSE"], ["cancel", "CANCEL"]]
          : [];
      for (const pair of buttons) {
        const button = document.createElement("button");
        button.textContent = pair[1];
        button.addEventListener("click", () => this.act(pair[0], task.id));
        actions.appendChild(button);
      }
      if (!buttons.length) actions.remove();
      el.tasks.appendChild(card);
    }
  },

  async act(action, taskId) {
    try {
      await fetch("/api/tasks/" + action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ task: taskId }),
      });
      toast(action + " requested");
      refreshProactive();
    } catch (_) {
      toast("Could not " + action + " the task", "err");
    }
  },
};

async function refreshProactive() {
  try {
    proactive.render(await (await fetch("/api/proactive")).json());
  } catch (_) {
    el.linkWatch.dataset.status = "offline";
    el.linkWatchState.textContent = "unknown";
  }
  try {
    proactive.renderTasks(await (await fetch("/api/tasks")).json());
  } catch (_) {
    /* The tasks panel is supplementary; a failure must not disturb the console. */
  }
}

el.quietBtn.addEventListener("click", async () => {
  const next = !proactive.quiet;
  await fetch("/api/proactive/settings", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ quiet: next }),
  });
  toast(next ? "Quiet mode on — only critical alerts" : "Quiet mode off");
  refreshProactive();
});

el.dismissAlerts.addEventListener("click", async () => {
  await fetch("/api/proactive/dismiss", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({}),
  });
  proactive.announced.clear();
  refreshProactive();
});

/* ══════════════════════ knowledge panel ══════════════════════ */

const knowledgePanel = {
  /* Show what retrieval actually returned, with its real sources. The method
     label comes from the server, so a keyword-only result is never presented
     as a semantic one. */
  show(result) {
    const rows = result.results || [];
    if (!rows.length && !result.limitation) return;

    el.kbPanel.hidden = false;
    el.kbMethod.textContent = (result.method || "").toUpperCase();
    el.kbMethod.dataset.semantic = String(!!result.semantic);

    el.kbSources.innerHTML = "";
    for (const row of rows.slice(0, 8)) {
      const card = document.createElement("div");
      card.className = "source";
      card.innerHTML =
        '<div class="source-head"><b></b><span class="lines"></span>' +
        '<span class="score"></span></div>' +
        '<div class="source-section"></div>' +
        '<div class="source-chunk"></div>' +
        '<div class="source-path"></div>';
      card.querySelector("b").textContent = row.source || "?";
      card.querySelector(".lines").textContent =
        row.lines ? "L" + row.lines[0] + "–" + row.lines[1] : "";
      card.querySelector(".score").textContent = row.method || "";
      const section = card.querySelector(".source-section");
      if (row.section) section.textContent = row.section;
      else section.remove();
      card.querySelector(".source-chunk").textContent = (row.chunk || "").slice(0, 260);
      card.querySelector(".source-path").textContent = row.path || "";
      card.title = row.path || "";
      el.kbSources.appendChild(card);
    }

    el.kbNote.hidden = !result.limitation;
    if (result.limitation) el.kbNote.textContent = result.limitation;

    logEvent("state", "Knowledge",
             rows.length + " source" + (rows.length === 1 ? "" : "s") +
             " · " + (result.method || ""));
  },

  clear() {
    el.kbPanel.hidden = true;
    el.kbSources.innerHTML = "";
  },
};

async function refreshSubsystems() {
  try {
    const kb = await (await fetch("/api/knowledge/status")).json();
    if (!kb.files) {
      el.linkKb.dataset.status = "off";
      el.linkKbState.textContent = "empty";
      el.linkKb.title = "Nothing indexed yet — ask Jarvish to index a folder.";
    } else {
      el.linkKb.dataset.status = kb.semantic_search ? "ok" : "degraded";
      el.linkKbState.textContent = kb.files + " files";
      el.linkKb.title = kb.semantic_search
        ? "Hybrid search: keyword + semantic"
        : (kb.limitation || "Keyword search only");
    }
  } catch (_) {
    el.linkKb.dataset.status = "offline";
    el.linkKbState.textContent = "unknown";
  }

  try {
    const browser = await (await fetch("/api/browser/status")).json();
    el.linkBrowser.dataset.status = browser.connected ? "ok" : "off";
    el.linkBrowserState.textContent = browser.connected
      ? (browser.tabs + " tab" + (browser.tabs === 1 ? "" : "s")) : "not attached";
    el.linkBrowser.title = browser.connected
      ? (browser.browser || "")
      : "No controllable browser. Ask Jarvish to launch one.";
  } catch (_) {
    el.linkBrowser.dataset.status = "offline";
    el.linkBrowserState.textContent = "unknown";
  }
}

/* ══════════════════════ confirmation gate ══════════════════════ */

function openGate(event) {
  state.pendingGate = event;
  el.gateCard.dataset.risk = event.risk;
  el.gateBadge.textContent = (event.risk_label || event.risk).toUpperCase();
  el.gateTitle.textContent = "Authorise " + event.name + "?";
  el.gateReason.textContent = event.reason;
  el.gatePreview.textContent = event.preview;
  el.gateMeta.innerHTML =
    "<span>RISK <b>" + esc(event.risk) + "</b></span>" +
    "<span>REVERSIBLE <b>" + (event.reversible ? "yes" : "no") + "</b></span>" +
    "<span>STOPPED BY <b>" + (event.autonomy_blocked ? "autonomy" : "risk") + "</b></span>";

  /* An action held by the ceiling rather than by its own risk is a different
     situation, and the remedy is different too: raise the level. Say so, so the
     user is not left thinking the action itself is dangerous. */
  el.gateCeiling.hidden = !event.autonomy_blocked;
  if (event.autonomy_blocked) {
    el.gateCeiling.textContent =
      "Your autonomy level is what stopped this, not the action's own risk. " +
      "Authorising runs it once; raising the level in the AUTONOMY panel stops " +
      "the asking.";
  }

  el.gate.hidden = false;
  el.gateDeny.focus();
  setState("awaiting", "waiting for your approval");
  logEvent("confirm", "Approval required", event.name);
}

async function answerGate(approved) {
  const pending = state.pendingGate;
  el.gate.hidden = true;
  state.pendingGate = null;
  if (!pending) return;
  try {
    await fetch("/api/confirm", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ session: state.session, id: pending.id, approved }),
    });
  } catch (_) {
    toast("Could not deliver the decision", "err");
  }
  logEvent(approved ? "ok" : "confirm", approved ? "Authorised" : "Declined", pending.name);
}

el.gateAllow.addEventListener("click", () => answerGate(true));
el.gateDeny.addEventListener("click", () => answerGate(false));

/* ══════════════════════ emergency stop ══════════════════════ */

async function emergencyStop(source) {
  tts.stop();
  if (state.pendingGate) answerGate(false);
  if (state.controller) { try { state.controller.abort(); } catch (_) {} }

  try {
    await fetch("/api/stop", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ session: state.session }),
    });
  } catch (_) { /* the local abort above already stopped the client */ }

  setState("stopped", "halted" + (source === "voice" ? " by voice" : ""));
  logEvent("stop", "EMERGENCY STOP", source === "voice" ? "spoken command" : "operator");
  toast("Stopped.");
  setTimeout(() => { if (state.agent === "stopped") setState("idle"); }, 2600);
}

/* ══════════════════════ the conversation ══════════════════════ */

function setBusy(value) {
  state.busy = value;
  el.send.disabled = value;
}

async function send(preset) {
  if (state.busy) return;
  const text = (preset !== undefined ? preset : el.input.value).trim();
  if (!text) return;

  tts.stop();
  el.input.value = "";
  autosize();
  pipeline.reset();

  addTurn("user", text);
  state.history.push({ role: "user", content: text });
  logEvent("user", "Command", text.slice(0, 90));

  setBusy(true);
  setState("analyzing");

  const view = addTurn("jarvis", "");
  const caret = document.createElement("span");
  caret.className = "caret";
  view.bubble.appendChild(caret);

  let answer = "";
  let touchedMemory = false;
  const chips = new Map();

  state.controller = new AbortController();

  try {
    const response = await fetch("/api/chat", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ messages: state.history, session: state.session }),
      signal: state.controller.signal,
    });
    if (!response.ok || !response.body) throw new Error("Server responded with " + response.status);

    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buffer = "";

    while (true) {
      const { value, done } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });

      const frames = buffer.split("\n\n");
      buffer = frames.pop();

      for (const frame of frames) {
        const line = frame.trim();
        if (!line.startsWith("data:")) continue;
        let event;
        try { event = JSON.parse(line.slice(5).trim()); } catch (_) { continue; }

        switch (event.type) {

          case "session":
            state.session = event.id;
            break;

          case "state":
            setState(event.state, event.label);
            logEvent("state", event.label);
            break;

          case "model":
            el.linkModel.textContent = event.model || "unavailable";
            el.linkOllama.dataset.status = event.degraded ? "degraded" : "ok";
            el.linkOllama.title = event.reason || "";
            logEvent("state", "Model", event.model + " · " + event.reason);
            break;

          case "token":
            answer += event.text;
            caret.remove();
            view.bubble.innerHTML = renderMarkdown(answer);
            view.bubble.appendChild(caret);
            tts.feed(event.text);
            coreView.pulse(0.3);
            scrollDown(false);
            break;

          case "plan":
            pipeline.plan(event.steps);
            logEvent("state", "Plan", event.steps.map((s) => s.name).join(" → "));
            break;

          case "confirm":
            openGate(event);
            break;

          case "tool_start":
            chips.set(event.id, addChip(view.strip, event));
            pipeline.bind(event.id, event.name, event.risk);
            logEvent("tool", event.name,
                     (event.parallel ? "∥ " : "") + summarise(event.arguments));
            if (/^(remember|forget|add_instruction|remove_instruction)$/.test(event.name)) {
              touchedMemory = true;
            }
            break;

          case "recovery":
            logEvent("error", "Retrying " + event.name, event.message.slice(0, 70));
            toast("Retrying " + event.name);
            break;

          case "tool_end": {
            const chip = chips.get(event.id);
            const status = event.declined ? "declined" : event.ok ? "ok" : "failed";
            pipeline.settle(event.id, status);
            if (chip) {
              chip.classList.add(status);
              chip.dataset.payload = JSON.stringify(event.result, null, 2);
              if (event.ms !== undefined) chip.querySelector(".ms").textContent = event.ms + "ms";
              if (!event.ok && event.result && event.result.error) {
                chip.querySelector(".args").textContent = String(event.result.error).slice(0, 60);
              }
            }
            logEvent(event.ok ? "ok" : "error",
                     event.name + (event.ok ? " ok" : status === "declined" ? " declined" : " failed"),
                     event.ms !== undefined ? event.ms + "ms" : "");
            // Anything that looked at the screen updates the vision panel.
            if (event.ok && event.result && event.result.frame) {
              visionPanel.show(event.result);
            }
            // Anything that retrieved from the index fills the knowledge panel.
            if (event.ok && event.result && Array.isArray(event.result.results)) {
              knowledgePanel.show(event.result);
            }
            // Developer tools feed the developer panel.
            developer.absorb(event.name, event.result);
            // Mission tools refresh mission control.
            if (/^(start_mission|mission_status|list_missions|pause_mission|resume_mission|cancel_mission|retry_mission_task)$/.test(event.name)) {
              mission.refresh();
            }
            // Registry tools open the capabilities panel.
            if (/^(list_capabilities|reload_plugins|capability_health|capability_info|set_capability)$/.test(event.name)) {
              registry.refresh(true);
            }
            if (/^(index_folder|knowledge_status|forget_folder)$/.test(event.name)) {
              refreshSubsystems();
            }
            if (/^(schedule_task|pause_task|resume_task|cancel_task|retry_task|proactive_settings|dismiss_notifications)$/.test(event.name)) {
              refreshProactive();
            }
            // A screenshot is worth showing rather than describing.
            if (event.ok && event.result && event.result.view_url) {
              const image = document.createElement("img");
              image.className = "shot";
              image.src = event.result.view_url;
              image.alt = "Screen capture";
              view.bubble.appendChild(image);
            }
            break;
          }

          case "insight":
            toast(event.text, event.severity === "critical" ? "err" : "");
            logEvent("error", "Observation", event.text);
            break;

          case "error":
            throw new Error(event.message);

          case "done":
            if (event.stopped) logEvent("stop", "Halted", "chain cancelled");
            break;
        }
      }
    }

    caret.remove();
    tts.flush();

    if (answer.trim()) {
      state.history.push({ role: "assistant", content: answer });
    } else if (state.agent !== "stopped") {
      view.bubble.innerHTML = "<p><em>No reply came back from the model.</em></p>";
    } else {
      view.turn.remove();
    }
    if (touchedMemory) loadMemory();

  } catch (error) {
    caret.remove();
    const message = String(error.message || error);

    if (error.name === "AbortError") {
      if (!answer.trim()) view.turn.remove();
    } else if (!answer.trim()) {
      view.turn.remove();
      // "network error" / "Failed to fetch" means the connection to Jarvish
      // itself dropped — almost always the server restarting — which is a very
      // different problem from Ollama being down, and needs a different answer.
      if (/network error|Failed to fetch|NetworkError|load failed/i.test(message)) {
        addNotice("Lost the connection to Jarvish.",
          "<p>The server restarted or stopped. Checking for it now — this " +
          "message clears on its own once it is back, and your message is safe " +
          "to send again.</p>");
        setState("error", "connection lost");
        logEvent("error", "Connection lost", "server unreachable");
        watchForServer();
      } else if (/reach Ollama|refused|ConnectError|10061/i.test(message)) {
        addNotice("Ollama is not responding.",
          "<p>Start it, then check the model with <code>npm run check</code>.</p>");
        setState("error", message.slice(0, 60));
        logEvent("error", "Fault", message.slice(0, 90));
      } else {
        addNotice("Something went wrong.", "<p>" + esc(message) + "</p>");
        setState("error", message.slice(0, 60));
        logEvent("error", "Fault", message.slice(0, 90));
      }
    }
  } finally {
    setBusy(false);
    state.controller = null;
    if (!["error", "stopped"].includes(state.agent)) {
      setState(tts.speaking ? "speaking" : "idle");
    }
    el.input.focus();
  }
}

/* ══════════════════════ side panels ══════════════════════ */

async function loadMemory() {
  try {
    const data = await (await fetch("/api/profile")).json();
    const facts = data.facts || {};
    const rules = data.instructions || [];

    el.memory.innerHTML = "";
    const keys = Object.keys(facts);
    if (!keys.length) {
      el.memory.innerHTML = '<p class="dim">nothing stored</p>';
    } else {
      for (const key of keys) {
        const row = document.createElement("div");
        row.className = "fact";
        const label = document.createElement("b");
        label.textContent = key.replace(/_/g, " ");
        const value = document.createElement("span");
        value.textContent = facts[key];
        row.append(label, value);
        el.memory.appendChild(row);
      }
    }

    el.rules.innerHTML = "";
    rules.forEach((rule, index) => {
      const row = document.createElement("div");
      row.className = "rule";
      const number = document.createElement("i");
      number.textContent = index + 1 + ".";
      const body = document.createElement("span");
      body.textContent = rule;
      row.append(number, body);
      el.rules.appendChild(row);
    });

    if (facts.name) el.brandSub.textContent = "at " + facts.name + "’s service";
  } catch (_) {
    /* The panel is supplementary; a failure must not disturb the console. */
  }
}

/* Poll until the server answers again, then put the interface back together.
   A restart used to leave the HUD showing a dead "network error" until the
   user thought to reload; now it recovers by itself. */
let serverWatch = null;

function watchForServer() {
  if (serverWatch) return;
  let attempt = 0;
  serverWatch = setInterval(async () => {
    attempt += 1;
    try {
      const response = await fetch("/api/health", { cache: "no-store" });
      if (!response.ok) throw new Error("not ready");
      clearInterval(serverWatch);
      serverWatch = null;
      toast("Reconnected to Jarvish");
      logEvent("state", "Reconnected", "server is back");
      setState("idle");
      refreshHealth();
      refreshSubsystems();
      refreshProactive();
      registry.refresh(false);
      autonomy.refresh();
      mission.refresh();
      openTelemetry();
    } catch (_) {
      if (attempt % 5 === 0) el.csText.textContent = "waiting for the server…";
    }
  }, 2000);
}

async function refreshHealth() {
  try {
    const status = await (await fetch("/api/health")).json();
    if (status.wake_word) state.wakeWord = status.wake_word;

    if (!status.online) {
      el.linkOllama.dataset.status = "offline";
      el.linkModel.textContent = "offline";
    } else if (!status.model_installed) {
      el.linkOllama.dataset.status = "degraded";
      el.linkModel.textContent = status.model + " not pulled";
    } else {
      el.linkOllama.dataset.status = "ok";
      el.linkModel.textContent = status.model;
    }
    el.toolCount.textContent = status.tool_count + (status.shell_enabled ? " +shell" : "");
    el.linkTools.dataset.status = "ok";
    autonomy.apply(status.autonomy);
  } catch (_) {
    el.linkOllama.dataset.status = "offline";
    el.linkModel.textContent = "server down";
  }

  el.linkNet.dataset.status = navigator.onLine ? "ok" : "offline";
  el.linkNetState.textContent = navigator.onLine ? "online" : "offline";
}

/* ══════════════════════ wiring ══════════════════════ */

function autosize() {
  el.input.style.height = "auto";
  el.input.style.height = Math.min(el.input.scrollHeight, 160) + "px";
}

function applyMute() {
  el.mute.setAttribute("aria-pressed", String(state.muted));
  el.muteIcon.textContent = state.muted ? "◌" : "◉";
  el.mute.title = state.muted ? "Spoken replies are off" : "Spoken replies are on";
}

el.input.addEventListener("input", autosize);
el.input.addEventListener("keydown", (event) => {
  if (event.key === "Enter" && !event.shiftKey) { event.preventDefault(); send(); }
});

el.send.addEventListener("click", () => send());
el.mic.addEventListener("click", () => persistentVoice.toggle());

el.wake.addEventListener("click", () => {
  const on = el.wake.getAttribute("aria-pressed") !== "true";
  el.wake.setAttribute("aria-pressed", String(on));
  if (on) {
    voice.toWake();
    mic.open();
    toast("Ambient mode on — say “" + state.wakeWord + "”");
  } else {
    voice.off();
    toast("Ambient mode off");
  }
});

el.mute.addEventListener("click", () => {
  state.muted = !state.muted;
  localStorage.setItem("jarvish.muted", state.muted ? "1" : "0");
  if (state.muted) tts.stop();
  applyMute();
  toast(state.muted ? "Voice output muted" : "Voice output on");
});

el.stop.addEventListener("click", () => emergencyStop("button"));
el.refreshMemory.addEventListener("click", loadMemory);

el.reset.addEventListener("click", () => {
  tts.stop();
  state.history = [];
  state.session = null;
  el.transcript.innerHTML = "";
  el.hud.classList.remove("engaged");
  pipeline.reset();
  visionPanel.clear();
  knowledgePanel.clear();
  developer.clear();
  el.capsPanel.hidden = true;
  el.missionPanel.hidden = true;
  mission.showing = null;
  setState("idle");
  el.input.focus();
  toast("New session");
});

document.addEventListener("keydown", (event) => {
  const key = event.key.toLowerCase();
  if (event.ctrlKey && key === "m") { event.preventDefault(); persistentVoice.toggle(); }
  else if (event.ctrlKey && key === "k") { event.preventDefault(); el.wake.click(); }
  else if (event.key === "Escape") {
    if (state.pendingGate) { answerGate(false); return; }
    emergencyStop("button");
  }
});

addEventListener("online", refreshHealth);
addEventListener("offline", refreshHealth);

applyMute();
setState("idle");
loadMemory();
refreshHealth();
refreshVision();
refreshSubsystems();
refreshProactive();
registry.refresh(false);
autonomy.refresh();
presence.begin();
persistentVoice.begin();
mission.refresh();
openTelemetry();
setInterval(refreshHealth, 15000);
setInterval(refreshVision, 60000);
setInterval(refreshSubsystems, 30000);
setInterval(refreshProactive, 6000);
setInterval(() => registry.refresh(false), 45000);
setInterval(() => mission.refresh(), 5000);
el.input.focus();
