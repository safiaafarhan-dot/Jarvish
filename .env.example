# --------------------------------------------------------------------------
# Jarvish environment — NAMES ONLY
# --------------------------------------------------------------------------
# Copy to `.env` and fill in locally, or set these in the Vercel project's
# Environment Variables page. `.env` is git-ignored and must never be
# committed. Every value below is optional: with none of them set, Jarvish
# runs exactly as it does today.
#
# Nothing here has a default that is a secret. The only variable that ever
# holds one is ANTHROPIC_API_KEY, and it is required *only* for the deployed
# cloud build — the local desktop assistant never reads it.

# --------------------------------------------------------------------------
# LOCAL (Windows desktop assistant) — python new.py
# --------------------------------------------------------------------------
# The local backend talks to Ollama on this machine. Ollama is not reachable
# from Vercel and must never be exposed publicly; leave these local.
JARVISH_OLLAMA_HOST=
JARVISH_MODEL=
JARVISH_HOST=
JARVISH_PORT=
JARVISH_WAKE_WORD=

# Optional local tuning — see README "Configuration" for the full list.
JARVISH_ALLOW_SHELL=
JARVISH_VISION=
JARVISH_BROWSER=
JARVISH_MCP_ENABLED=
JARVISH_WHISPER_MODEL=

# --------------------------------------------------------------------------
# PRODUCTION (Vercel) — set these in the Vercel dashboard, not in a file
# --------------------------------------------------------------------------
# Without ANTHROPIC_API_KEY the deployment still builds, still serves the
# interface, and answers chat with a plain statement that no model is
# configured. It does not crash and it does not pretend to have one.
ANTHROPIC_API_KEY=

# Optional overrides for the cloud model. Defaults are chosen in
# web/api/[...path].py; leave blank to accept them.
JARVISH_CLOUD_MODEL=
JARVISH_CLOUD_MAX_TOKENS=

# Comma-separated origins allowed to call the deployed API cross-origin.
# Leave blank — the interface and the API share one origin on Vercel, so no
# CORS header is needed and none is sent. Only fill this in if you host the
# interface somewhere other than the Vercel project serving these functions.
JARVISH_ALLOWED_ORIGINS=
