         "including whether a vision-capable model is installed."),
]


REGISTRY = {
    "look_at_screen": tool_look,
    "read_screen_text": tool_read,
    "find_on_screen": tool_find,
    "click_on_screen": tool_click,
    "describe_active_window": tool_window,
    "vision_status": tool_capabilities,
}
