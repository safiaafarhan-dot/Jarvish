{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'Jarvish: skipping install. The desktop assistant is Windows-only and is not part of this build.'",
  "buildCommand": "echo 'Jarvish: nothing to build. web/ is a plain static interface.'",
  "outputDirectory": "web",
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
